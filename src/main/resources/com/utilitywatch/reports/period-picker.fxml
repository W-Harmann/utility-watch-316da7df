<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.utilitywatch.controller.PeriodPickerController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <Label text="From:"/>
        <DatePicker fx:id="fromDatePicker" promptText="Start date"/>
        <Label text="To:"/>
        <DatePicker fx:id="toDatePicker" promptText="End date"/>
    </children>
</HBox>