<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.CustomiseReportController"
      styleClass="reports-root">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Label text="Customise your report" styleClass="reports-title"/>

    <!-- utility toggle and period selector -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Utility:"/>

        <fx:define>
            <ToggleGroup fx:id="customiseUtilityToggleGroup"/>
        </fx:define>

        <ToggleButton text="Energy" styleClass="utility-toggle, energy-toggle" toggleGroup="$customiseUtilityToggleGroup"/>
        <ToggleButton text="Water" styleClass="utility-toggle, water-toggle" toggleGroup="$customiseUtilityToggleGroup"/>
        <ToggleButton text="Both" styleClass="utility-toggle, both-toggle" toggleGroup="$customiseUtilityToggleGroup" selected="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Period:"/>
        <Button text="Aug 1 - Sep 1, 2026" styleClass="period-button"/>
    </HBox>

    <!-- two side by side widgets -->
    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- left widget - report checkbox selection options -->
        <VBox spacing="8.0" styleClass="report-info-box" HBox.hgrow="ALWAYS">
            <Label text="Select information to include:" styleClass="report-info-box-title"/>

            <CheckBox text="Select All"/>
            <CheckBox text="Consumption Statistics" selected="true"/>
            <CheckBox text="Trends Analysis" selected="true"/>
            <CheckBox text="Comparisons" selected="true"/>
            <CheckBox text="Unusual Patterns" selected="true"/>
            <CheckBox text="Conservation Opportunities"/>
            <CheckBox text="Cost Summary" selected="true"/>
            <CheckBox text="Environmental Impact"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Note: you must select at least one item to generate a report."
                   wrapText="true" styleClass="report-note"/>
        </VBox>

        <!-- right widget - preview of selected choices (static text for now) -->
        <!-- TODO: update to add the options based on which checkboxes are checked -->
        <VBox spacing="8.0" styleClass="report-info-box" HBox.hgrow="ALWAYS">
            <Label text="Your report will include:" styleClass="report-info-box-title"/>
            <Label text="Consumption Statistics"/>
            <Label text="Trends Analysis"/>
            <Label text="Comparisons"/>
            <Label text="Unusual Patterns"/>
            <Label text="Cost Summary"/>
        </VBox>

    </HBox>

    <!-- cancel and generate report buttons -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button text="Cancel" styleClass="cancel-button" onAction="#onCancelClick"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Generate Report" styleClass="generate-report-button" onAction="#onGenerateReportClick"/>
    </HBox>

</VBox>