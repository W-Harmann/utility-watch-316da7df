<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.BarChart?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.CheckBox?>
<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.ReportsController"
      styleClass="reports-root"
      VBox.vgrow="ALWAYS"
      maxHeight="Infinity">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- title and generate report button -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Detailed Report" styleClass="reports-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Generate Report" styleClass="generate-report-button" onAction="#onGenerateReportClick"/>
    </HBox>

    <!-- utility toggle and period selector button -->
    <HBox alignment="CENTER_LEFT" fx:id="utilityToggle" spacing="10.0">
        <Label text="Utility:"/>

        <fx:define>
            <ToggleGroup fx:id="utilityToggleGroup"/>
        </fx:define>

        <ToggleButton fx:id="energyToggle" text="Energy" styleClass="utility-toggle, energy-toggle" toggleGroup="$utilityToggleGroup"/>
        <ToggleButton fx:id="waterToggle" text="Water" styleClass="utility-toggle, water-toggle" toggleGroup="$utilityToggleGroup"/>
        <ToggleButton fx:id="bothToggle" text="Both" styleClass="utility-toggle, both-toggle" toggleGroup="$utilityToggleGroup" selected="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Period:"/>
        <Button fx:id="periodButton" text="Aug 1 - Sep 1, 2026" styleClass="period-button"/>
    </HBox>

    <!-- utility toggle and period selector button -->
    <HBox alignment="CENTER_LEFT" fx:id="trendmodeToggle" spacing="10.0" visible="false" managed="false">
        <Label text="Mode:"/>

        <fx:define>
            <ToggleGroup fx:id="trendmodeToggleGroup"/>
        </fx:define>

        <ToggleButton fx:id="trendmodeTotalToggle" text="Total" styleClass="utility-toggle, both-toggle" toggleGroup="$trendmodeToggleGroup" selected="true"/>
        <ToggleButton fx:id="trendmodeChangeToggle" text="Change" styleClass="utility-toggle, both-toggle" toggleGroup="$trendmodeToggleGroup"/>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- report tab buttons - uses a toggle group so the active tab stays visually marked -->
    <!-- outer HBox stops the tab row and its underline from stretching to the full width -->
    <HBox>
        <HBox spacing="15.0" styleClass="report-tabs-row">
            <fx:define>
                <ToggleGroup fx:id="reportTabToggleGroup"/>
            </fx:define>

            <ToggleButton text="Overview" styleClass="report-tab-button" toggleGroup="$reportTabToggleGroup" selected="true" onAction="#onOverviewTabClick"/>
            <ToggleButton text="Trends" styleClass="report-tab-button" toggleGroup="$reportTabToggleGroup" onAction="#onTrendsTabClick"/>
            <ToggleButton text="Comparisons" styleClass="report-tab-button" toggleGroup="$reportTabToggleGroup" onAction="#onComparisonsTabClick"/>
            <ToggleButton text="Unusual Patterns" styleClass="report-tab-button" toggleGroup="$reportTabToggleGroup" onAction="#onUnusualTabClick"/>
            <ToggleButton text="Statistics" styleClass="report-tab-button" toggleGroup="$reportTabToggleGroup" onAction="#onStatisticsTabClick"/>
        </HBox>
    </HBox>

    <!-- OVERVIEW TAB content in 2x2 grid layout -->
    <VBox fx:id="overviewContentBox" spacing="15.0" VBox.vgrow="ALWAYS">
        <GridPane hgap="15.0" vgap="15.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints percentWidth="40.0"/>
                <ColumnConstraints percentWidth="60.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="55.0"/>
                <RowConstraints percentHeight="45.0"/>
            </rowConstraints>

            <!-- comparisons widget (row 1 column 1) -->
            <VBox spacing="14.0" styleClass="report-info-box">
                <Label text="Comparisons" styleClass="report-info-box-title"/>
                <Label fx:id="totalEnergyLabel" text="Total Energy: 326 kWh"/>
                <Label fx:id="totalWaterLabel" text="Total Water: 12,340 L"/>
                <Label text="Compared to Jul 1 - Jul 31:" styleClass="report-info-box-subtitle"/>
                <Label fx:id="energyChangeLabel" text="Energy usage increased by 8%"/>
                <Label fx:id="waterChangeLabel" text="Water usage decreased by 5%"/>
            </VBox>

            <!-- consumption chart (row 1 column 2) -->
            <LineChart fx:id="consumptionChart" title="Consumption over time" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </LineChart>

            <!-- key statistics widget (row 2 column 1) -->
            <VBox spacing="14.0" styleClass="report-info-box" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Key Statistics" styleClass="report-info-box-title"/>

                <!-- nested grid for statistics table -->
                <GridPane hgap="15.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="60.0"/>
                        <ColumnConstraints minWidth="80.0"/>
                        <ColumnConstraints minWidth="70.0"/>
                    </columnConstraints>

                    <!-- row 1 column 2 for energy header -->
                    <Label text="Energy (kWh)" styleClass="energy-column-header" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <!-- row 1 column 3 for water header -->
                    <Label text="Water (L)" styleClass="water-column-header" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                    <!-- row 2 column 1 for average header -->
                    <Label text="Average" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <!-- row 2 column 2 for average energy consumption -->
                    <Label fx:id="avgEnergyLabel" text="10.2" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <!-- row 2 column 3 for average water consumption -->
                    <Label fx:id="avgWaterLabel" text="354" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                    <!-- row 3 column 1 for minimum header -->
                    <Label text="Minimum" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <!-- row 3 column 2 for min energy consumption -->
                    <Label fx:id="minEnergyLabel" text="18.6" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <!-- row 3 column 3 for min water consumption -->
                    <Label fx:id="minWaterLabel" text="679" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                    <!-- row 4 column 1 for maximum header -->
                    <Label text="Maximum" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <!-- row 4 column 2 for max energy consumption -->
                    <Label fx:id="maxEnergyLabel" text="5.1" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <!-- row 4 column 3 for max water consumption -->
                    <Label fx:id="maxWaterLabel" text="210" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <!-- unusual patterns table (row 2 column 2) -->
            <VBox spacing="14.0" styleClass="report-info-box" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Unusual Patterns Detected" styleClass="report-info-box-title"/>

                <GridPane hgap="15.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="70.0"/>
                        <ColumnConstraints minWidth="75.0"/>
                        <ColumnConstraints minWidth="70.0"/>
                        <ColumnConstraints minWidth="110.0"/>
                    </columnConstraints>

                    <!-- table headings -->
                    <Label text="Date/Period" styleClass="report-info-box-subtitle" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Type" styleClass="report-info-box-subtitle" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Severity" styleClass="report-info-box-subtitle" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label text="Details" styleClass="report-info-box-subtitle" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Aug 22 (2h)" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label text="High Usage" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Severe" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Label text="+32% above usual" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Aug 24 (1h)" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label text="Spike" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Moderate" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <Label text="Short spike detected" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <Label text="Aug 26 (6h)" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label text="Long duration" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Moderate" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <Label text="Usage for 6+ hours" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

        </GridPane>
    </VBox>

    <!-- TRENDS TAB content -->
    <VBox fx:id="trendsContentBox" spacing="15.0" visible="false" managed="false" VBox.vgrow="ALWAYS" maxHeight="Infinity">
        <!-- Scroll Bar -->
        <ScrollPane hbarPolicy="never" vbarPolicy="always" VBox.vgrow="NEVER" fitToWidth="true" prefHeight="1000">
            <VBox>
                <!-- Energy Display -->
                <HBox spacing="15.0" alignment="CENTER" styleClass="report-info-box" maxHeight="80">
                    <Label text="Energy" styleClass="stat-value"/>
                    <Pane HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="trendShowEnergyTrendButton" text="Show" onAction="#onShowEnergyTrendClick"/>
                </HBox>
                <!-- Energy Display | Graph -->
                <HBox spacing="15.0" fx:id="trendEnergyDisplay" styleClass="report-info-box"  visible="false" managed="false" prefHeight="300">
                    <!-- Graph -->
                    <BarChart title="Test Chart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis/>
                        </yAxis>
                    </BarChart>
                </HBox>

                <!-- Water Display-->
                <HBox spacing="15.0" alignment="CENTER" styleClass="report-info-box" maxHeight="80">
                    <Label text="Water" styleClass="stat-value"/>
                    <Pane HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="trendShowWaterTrendButton" text="Show" onAction="#onShowWaterTrendClick"/>
                </HBox>
                <!-- Water Display | Graph -->
                <HBox spacing="15.0" fx:id="trendWaterDisplay" styleClass="report-info-box" visible="false" managed="false" prefHeight="300">
                    <!-- Graph -->
                    <BarChart title="Test Chart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis/>
                        </yAxis>
                    </BarChart>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- STATISTICS TAB content -->
    <VBox fx:id="statisticsContentBox" spacing="15.0" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <HBox spacing="15.0">
            <!-- median consumption widget -->
            <!-- maxWidth and prefWidth makes both statistic boxes share the available space equally -->
            <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <Label text="Median" styleClass="report-info-box-title"/>
                <Label text="10.4 kWh" styleClass="stat-value"/>
                <Label text="Your typical day's usage"/>
            </VBox>

            <!-- standard deviation consumption widget -->
            <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <Label text="Standard deviation" styleClass="report-info-box-title"/>
                <Label text="3.2 kWh" styleClass="stat-value"/>
                <Label text="How much your usage varies day to day"/>
            </VBox>
        </HBox>

        <!-- daily usage distribution chart -->
        <BarChart fx:id="distributionChart" title="Daily usage distrubition" legendVisible="false" VBox.vgrow="ALWAYS">
            <xAxis>
                <CategoryAxis/>
            </xAxis>
            <yAxis>
                <NumberAxis/>
            </yAxis>
        </BarChart>

        <!-- bottom row for most common range, variability, and days recorded widgets -->
        <HBox spacing="15.0">
            <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <Label text="Most common range" styleClass="report-info-box-title"/>
                <Label text="9-11 kWh" styleClass="stat-value"/>
            </VBox>

            <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <Label text="Variability" styleClass="report-info-box-title"/>
                <Label text="Moderate" styleClass="stat-value"/>
            </VBox>

            <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <Label text="Days recorded" styleClass="report-info-box-title"/>
                <Label text="30 of 30" styleClass="stat-value"/>
            </VBox>
        </HBox>

    </VBox>

    <!-- placeholder for tabs not built yet -->
    <!-- managed=false so the hidden label does not leave an empty space in the layout -->
    <Label fx:id="comingSoonLabel"  text="Coming soon" visible="false" managed="false"/>

</VBox>