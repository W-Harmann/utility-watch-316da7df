<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.NotificationsController"
      styleClass="reports-root"
      VBox.vgrow="ALWAYS"
      maxHeight="Infinity">


    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Notifications" styleClass="reports-title"/>
    </HBox>

    <HBox spacing="15.0">
        <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
            <Label text="2" styleClass="stat-value"/>
            <Label text="New Notifications" styleClass="report-info-box-title"/>
        </VBox>

        <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
            <Label text="5" styleClass="stat-value"/>
            <Label text="This Month" styleClass="report-info-box-title"/>
        </VBox>

        <VBox alignment="CENTER" styleClass="report-info-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
            <Label text="12" styleClass="stat-value"/>
            <Label text="Exemptions" styleClass="report-info-box-title"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Recent Notifications" styleClass="reports-title"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com">
        <VBox fx:id="recentNotificationsContainer" spacing="10.0">
        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="View All Notifications" styleClass="generate-report-button" onAction="#onViewAllNotifications"/>
    </HBox>

</VBox>