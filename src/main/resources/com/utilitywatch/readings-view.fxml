<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.ReadingsController"
      spacing="10">

    <Label text="Readings" styleClass="form-title"/>

    <HBox spacing="8">
        <DatePicker fx:id="datePicker"/>
        <ComboBox fx:id="resourceTypeBox" promptText="Type"/>
        <TextField fx:id="quantityField" promptText="Quantity"/>
        <Button fx:id="saveButton" text="Save Reading" styleClass="primary-button" onAction="#onSaveClick"/>
        <Button text="Import CSV" styleClass="primary-button" onAction="#onImportClick"/>
    </HBox>
    <Label fx:id="errorLabel" styleClass="error-label"/>
    <Label fx:id="importResultLabel"/>

    <TableView fx:id="readingsTable">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="180"/>
            <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="90"/>
            <TableColumn fx:id="resourceTypeColumn" text="Type" prefWidth="80"/>
            <TableColumn fx:id="unitColumn" text="Unit" prefWidth="80"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="140"/>
        </columns>
    </TableView>

</VBox>
