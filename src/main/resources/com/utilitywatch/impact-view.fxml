<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- US10.1 - Environmental Impacts page; US10.3 - footprint over time chart -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.utilitywatch.controller.ImpactController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="page-scroll"
            style="-fx-background-color: transparent; -fx-background: #FFFFFF;">
    <content>
        <VBox spacing="14">

            <fx:define>
                <ToggleGroup fx:id="utilityGroup"/>
                <ToggleGroup fx:id="groupingGroup"/>
            </fx:define>

            <Label text="Environmental Impacts" styleClass="form-title"/>

            <!-- Utility and period -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Utility:"/>
                <HBox>
                    <ToggleButton text="Energy" userData="energy" toggleGroup="$utilityGroup" styleClass="utility-toggle, energy-toggle"/>
                    <ToggleButton text="Water" userData="water" toggleGroup="$utilityGroup" styleClass="utility-toggle, water-toggle"/>
                    <ToggleButton fx:id="bothToggle" text="Both" userData="both" toggleGroup="$utilityGroup" styleClass="utility-toggle, both-toggle"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Period:"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="130"/>
                <Label text="–"/>
                <DatePicker fx:id="toDatePicker" prefWidth="130"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label"/>

            <!-- Footprint and by-utility cards -->
            <HBox spacing="14">
                <VBox styleClass="report-info-box" spacing="8" HBox.hgrow="ALWAYS" prefWidth="300" maxWidth="Infinity">
                    <Label text="Footprint this Period" styleClass="report-info-box-title"/>
                    <HBox spacing="6" alignment="BASELINE_LEFT">
                        <Label fx:id="footprintLabel" styleClass="stat-value"/>
                        <Label text="kg CO₂e"/>
                    </HBox>
                    <Label fx:id="changeLabel" styleClass="report-note" wrapText="true"/>
                </VBox>

                <VBox styleClass="report-info-box" spacing="10" HBox.hgrow="ALWAYS" prefWidth="300" maxWidth="Infinity">
                    <Label text="By Utility" styleClass="report-info-box-title"/>
                    <VBox fx:id="energyRow" spacing="4">
                        <HBox>
                            <Label text="Electricity"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="energyImpactLabel" styleClass="energy-column-header"/>
                        </HBox>
                        <ProgressBar fx:id="energyBar" progress="0" maxWidth="Infinity" styleClass="energy-bar"/>
                    </VBox>
                    <VBox fx:id="waterRow" spacing="4">
                        <HBox>
                            <Label text="Water"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="waterImpactLabel" styleClass="water-column-header"/>
                        </HBox>
                        <ProgressBar fx:id="waterBar" progress="0" maxWidth="Infinity" styleClass="water-bar"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Footprint over time (US10.3): the chart itself is added by ImpactController -->
            <VBox styleClass="trends-tab-utility-display" spacing="8">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Footprint Over Time" styleClass="report-info-box-title"/>
                    <!-- legend, only shown when both utilities are drawn as separate lines -->
                    <HBox fx:id="trendLegend" spacing="12" alignment="CENTER_LEFT">
                        <Label text="Energy">
                            <graphic><Circle radius="5" fill="#FFBA4A"/></graphic>
                        </Label>
                        <Label text="Water">
                            <graphic><Circle radius="5" fill="#5FB2F5"/></graphic>
                        </Label>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Group by:"/>
                    <HBox>
                        <ToggleButton fx:id="weeklyToggle" text="Weekly" userData="WEEKLY" toggleGroup="$groupingGroup" styleClass="utility-toggle, both-toggle"/>
                        <ToggleButton fx:id="monthlyToggle" text="Monthly" userData="MONTHLY" toggleGroup="$groupingGroup" styleClass="utility-toggle, both-toggle"/>
                    </HBox>
                </HBox>
                <VBox fx:id="trendChartBox" prefHeight="300" minHeight="260"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="trendSummaryLabel"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Grey band = no readings  •  Gap in a line = no readings for that utility  •  A point on 0 = readings with no footprint"/>
                </HBox>
            </VBox>

            <!-- Comparison with the QLD average -->
            <VBox styleClass="report-info-box" spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Impacts in Comparison" styleClass="report-info-box-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="QLD average is mock data • total footprint (energy + water)" styleClass="report-note"/>
                </HBox>
                <VBox spacing="4">
                    <HBox>
                        <Label text="You"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="userTotalLabel" styleClass="user-column-header"/>
                    </HBox>
                    <ProgressBar fx:id="userBar" progress="0" maxWidth="Infinity" styleClass="user-bar"/>
                </VBox>
                <VBox spacing="4">
                    <HBox>
                        <Label text="QLD average"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="stateTotalLabel" styleClass="state-column-header"/>
                    </HBox>
                    <ProgressBar fx:id="stateBar" progress="0" maxWidth="Infinity" styleClass="state-bar"/>
                </VBox>
                <Label fx:id="stateComparisonLabel" styleClass="report-info-box-title"/>
            </VBox>

            <!-- Emission factors bar -->
            <VBox styleClass="report-info-box" spacing="8">
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="Emission Factors" styleClass="report-info-box-title"/>
                    <Label fx:id="energyFactorLabel" styleClass="energy-column-header"/>
                    <Label fx:id="waterFactorLabel" styleClass="water-column-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="editFactorsButton" text="Edit Factors" onAction="#onEditFactorsClick"/>
                </HBox>
                <HBox fx:id="factorsEditBox" spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="energyFactorField" promptText="kg CO₂e per kWh" prefWidth="160"/>
                    <TextField fx:id="waterFactorField" promptText="kg CO₂e per litre" prefWidth="160"/>
                    <Button text="Save" onAction="#onSaveFactorsClick"/>
                    <Button text="Cancel" styleClass="cancel-button" onAction="#onCancelFactorsClick"/>
                </HBox>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
