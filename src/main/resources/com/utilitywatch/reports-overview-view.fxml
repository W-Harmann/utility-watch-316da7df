<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.ReportsController"
      styleClass="reports-root">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- title and generate report button -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Detailed Report" styleClass="reports-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Generate Report" styleClass="generate-report-button" onAction="#onGenerateReportClick"/>
    </HBox>

    <!-- utility toggle and period selector button -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Utility:"/>

        <fx:define>
            <ToggleGroup fx:id="utilityToggleGroup"/>
        </fx:define>

        <ToggleButton fx:id="energyToggle" text="Energy" styleClass="utility-toggle, energy-toggle" toggleGroup="$utilityToggleGroup"/>
        <ToggleButton fx:id="waterToggle" text="Water" styleClass="utility-toggle, water-toggle" toggleGroup="$utilityToggleGroup"/>
        <ToggleButton fx:id="bothToggle" text="Both" styleClass="utility-toggle, both-toggle" toggleGroup="$utilityToggleGroup" selected="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Period:"/>
        <Button fx:id="periodButton" text="Aug 1 - Sep 1, 2026" styleClass="period-button"/>
    </HBox>

    <!-- report tab buttons -->
    <HBox spacing="15.0">
        <Button text="Overview" styleClass="report-tab-button" onAction="#onOverviewTabClick"/>
        <Button text="Trends" styleClass="report-tab-button" onAction="#onTrendsTabClick"/>
        <Button text="Comparisons" styleClass="report-tab-button" onAction="#onComparisonsTabClick"/>
        <Button text="Unusual Patterns" styleClass="report-tab-button" onAction="#onUnusualTabClick"/>
        <Button text="Statistics" styleClass="report-tab-button" onAction="#onStatisticsTabClick"/>
    </HBox>

</VBox>