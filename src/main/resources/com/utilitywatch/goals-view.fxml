<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.GoalsController"
      styleClass="reports-root"
      VBox.vgrow="ALWAYS"
      maxHeight="Infinity">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- title and create new goal button -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Goals and Progress" styleClass="reports-title"/>
        <Region/>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <fx:define>
                <ToggleGroup fx:id="resourceToggleGroup"/>
            </fx:define>

            <!-- resource type toggle replaces title field to avoid relying on typed goal type (user feedback) -->
            <ToggleButton fx:id="energyToggle" text="Energy" styleClass="utility-toggle, energy-toggle" toggleGroup="$resourceToggleGroup"/>
            <ToggleButton fx:id="waterToggle" text="Water" styleClass="utility-toggle, water-toggle" toggleGroup="$resourceToggleGroup"/>

            <!-- percentage label makes it clear the target is a percentage reduction (user feedback) -->
            <TextField fx:id="targetField" prefWidth="70.0" promptText="e.g. 15"/>
            <Label text="\%"/>

            <!-- set period options so users select a valid format instead of entering the period as free text (user feedback) -->
            <ComboBox fx:id="periodComboBox" promptText="Select a period"/>
            <Button text="Create New Goal" styleClass="generate-report-button" onAction="#onCreateNewGoalClick"/>
        </HBox>

    </HBox>

    <!-- error message shown when the entered goal values are invalid -->
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>

    <!-- goal tab buttons - uses a toggle group so the active tab stays visually marked -->
    <!-- outer HBox stops the tab row and its underline from stretching to the full width -->
    <HBox>
        <HBox spacing="15.0" styleClass="report-tabs-row">
            <fx:define>
                <ToggleGroup fx:id="GoalsToggleGroup"/>
            </fx:define>

            <ToggleButton text="Active" styleClass="report-tab-button" toggleGroup="$GoalsToggleGroup" selected="true" onAction="#onActiveGoalsClick"/>
            <ToggleButton text="Completed" styleClass="report-tab-button" toggleGroup="$GoalsToggleGroup" onAction="#onCompletedGoalsClick"/>
        </HBox>
    </HBox>

    <!-- ACTIVE GOAL CONTENT TAB content -->
    <VBox fx:id="activeGoalContentBox" spacing="15.0" VBox.vgrow="ALWAYS">
        <Label text="Active" styleClass="reports-title"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com">
            <VBox fx:id="goalContainer" spacing="10.0" styleClass="report-info-box" />
        </ScrollPane>
    </VBox>

    <!-- COMPLETED GOAL CONTENT TAB content -->
    <VBox fx:id="completedGoalContentBox" spacing="15.0" VBox.vgrow="ALWAYS" visible="false" managed="false">
        <Label text="Completed" styleClass="reports-title"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="400.0" prefWidth="400.0">
            <VBox fx:id="completedGoalContainer" spacing="15.0" styleClass="report-info-box"/>
        </ScrollPane>
    </VBox>


    <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
        <Button fx:id="conservationMenu" text="Learn How to Begin Conserving!" styleClass="flag-navigation-button" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity" onAction="#onConservationClick"/>
    </VBox>

</VBox>
