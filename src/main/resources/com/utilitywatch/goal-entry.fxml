<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.utilitywatch.controller.GoalEntryController">
        <HBox alignment="CENTER" spacing="10.0">
            <VBox>
                <Label fx:id="goalContainerTitle" text="Reduce Use" styleClass="reports-title"/>
                <Label fx:id="goalContainerTarget" text="Target: 15% reduction"/>
                <Label fx:id="goalContainerPeriod" text="Period: Aug 1 - Sep 1, 2026"/>
                <Label fx:id="goalContainerProgress" text="Progress: 62%"/>
            </VBox>
            <VBox alignment="CENTER">
                <Button fx:id="viewGoalDetails" text="View Details"/>
                <Button fx:id="editGoalDetails" text="Edit"/>
                <Button fx:id="deleteGoal" text="Delete"/>
            </VBox>
        </HBox>
    </VBox>
