<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.AlertEntryController"
      styleClass="report-info-box">
    <VBox>
        <Label fx:id="alertTitleLabel" text="Alert title" styleClass="reports-title"/>
        <Label fx:id="alertTimeLabel" text="Date"/>
        <Label fx:id="alertMessageLabel" text="Message"/>
    </VBox>
</HBox>