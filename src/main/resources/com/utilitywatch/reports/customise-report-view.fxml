<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utilitywatch.controller.CustomiseReportController"
      styleClass="reports-root">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Label text="Customise your report" styleClass="reports-title"/>

    <!-- utility toggle and period selector -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Utility:"/>

        <fx:define>
            <ToggleGroup fx:id="customiseUtilityToggleGroup"/>
        </fx:define>

        <ToggleButton text="Energy" styleClass="utility-toggle, energy-toggle" toggleGroup="$customiseUtilityToggleGroup"/>
        <ToggleButton text="Water" styleClass="utility-toggle, water-toggle" toggleGroup="$customiseUtilityToggleGroup"/>
        <ToggleButton text="Both" styleClass="utility-toggle, both-toggle" toggleGroup="$customiseUtilityToggleGroup" selected="true"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- shows period picker -->
        <fx:include source="period-picker.fxml" fx:id="periodPicker"/>
    </HBox>

    <!-- two side by side widgets -->
    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- left widget - report checkbox selection options -->
        <VBox spacing="8.0" styleClass="report-info-box" HBox.hgrow="ALWAYS">
            <Label text="Select information to include:" styleClass="report-info-box-title"/>

            <CheckBox fx:id="selectAllCheckBox" text="Select All" onAction="#onSelectAllClick"/>
            <CheckBox fx:id="consumptionStatisticsCheckBox" text="Consumption Statistics" onAction="#handleCheckboxAction"/>
            <CheckBox fx:id="trendsAnalysisCheckBox" text="Trends Analysis" onAction="#handleCheckboxAction"/>
            <CheckBox fx:id="comparisonsCheckBox" text="Comparisons" onAction="#handleCheckboxAction"/>
            <CheckBox fx:id="unusualPatternsCheckBox" text="Unusual Patterns" onAction="#handleCheckboxAction"/>
            <CheckBox fx:id="conservationOpportunitiesCheckBox" text="Conservation Opportunities" onAction="#handleCheckboxAction"/>
            <CheckBox fx:id="costSummaryCheckBox" text="Cost Summary" onAction="#handleCheckboxAction"/>
            <CheckBox fx:id="environmentalImpactCheckBox" text="Environmental Impact" onAction="#handleCheckboxAction"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Note: you must select at least one item to generate a report."
                   wrapText="true" styleClass="report-note"/>
        </VBox>

        <!-- right widget - preview of selected choices (static text for now) -->
        <!-- TODO: update to add the options based on which checkboxes are checked -->
        <VBox fx:id="previewContainer" spacing="8.0" styleClass="report-info-box" HBox.hgrow="ALWAYS">
            <Label text="Your report will include:" styleClass="report-info-box-title"/>
        </VBox>

    </HBox>

    <!-- cancel and generate report buttons -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button text="Cancel" styleClass="cancel-button" onAction="#onCancelClick"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Generate Report" styleClass="generate-report-button" onAction="#onGenerateReportClick"/>
    </HBox>

</VBox>